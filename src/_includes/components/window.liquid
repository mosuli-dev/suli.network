<div style="
  border: 2px solid #000;
  background: #e0e0e0;
  margin-bottom: 20px;
  font-family: 'Inconsolata', monospace;
  min-width: 400px;
  max-width: 550px;
  min-height: 200px;
  overflow-y: auto;
  position: relative;
  " class="window {{ class | default: '' }}">

  <!-- Window Header -->
  <div style="
    background: linear-gradient(to right, #000080, #1084d0);
    color: white;
    padding: 6px 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    font-weight: 500;
    position: sticky;
    top: 0;
  ">
    
    <!-- Title -->
    <div>
      {{ window-title | default: "Window" }}
    </div>

    <!-- Controls -->
    <div>
      <span style="
        background: #c0c0c0;
        border: 1px solid #000;
        padding: 0px 6px;
        margin-left: 4px;
        color: black;
      ">_</span>

      <span style="
        background: #c0c0c0;
        border: 1px solid #000;
        padding: 0px 6px;
        margin-left: 4px;
        color: black;
      ">□</span>

      <span style="
        background: #c0c0c0;
        border: 1px solid #000;
        padding: 0px 6px;
        margin-left: 4px;
        color: black;
      ">×</span>
    </div>

  </div>

  <!-- Window Content -->
  <div class="window-content">
    {{ content | default: "This is the content area of the window. You can put anything here!" }}
  </div>
  <div class="resize-handle"> <span style="
        background: #c0c0c0;
        border: 1px solid #000;
        padding: 0px 6px;
        margin-left: 4px;
        color: black;
        position: absolute;
        bottom: 0;
        right: 0;
      ">↘</span> </div>

</div>