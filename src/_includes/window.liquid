<div style="
  border: 2px solid #000;
  background: #e0e0e0;
  box-shadow: 4px 4px 0px #000;
  margin-bottom: 20px;
  font-family: 'Inconsolata', monospace;
">

  <!-- Window Header -->
  <div style="
    background: linear-gradient(to right, #000080, #1084d0);
    color: white;
    padding: 6px 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    font-weight: 500;
  ">
    
    <!-- Title -->
    <div>
      {{ title | default: "Window" }}
    </div>

    <!-- Controls -->
    <div>
      <span style="
        background: #c0c0c0;
        border: 1px solid #000;
        padding: 0px 6px;
        margin-left: 4px;
        color: black;
      ">_</span>

      <span style="
        background: #c0c0c0;
        border: 1px solid #000;
        padding: 0px 6px;
        margin-left: 4px;
        color: black;
      ">□</span>

      <span style="
        background: #c0c0c0;
        border: 1px solid #000;
        padding: 0px 6px;
        margin-left: 4px;
        color: black;
      ">×</span>
    </div>

  </div>

  <!-- Window Content -->
  <div style="
    background: white;
    padding: 12px;
    font-size: 14px;
    min-width: 300px;
    max-width: 600px;
    min-height: 100px;
    max-height: fit-content;
  ">
    {{ content | default: "This is the content area of the window. You can put anything here!" }}
  </div>

</div>